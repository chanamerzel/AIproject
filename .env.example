FLASK_SECRET_KEY=change-me
# Host port for docker compose (change if 5000 is taken by another project)
WEB_PORT=5000
AGENT_API_KEY=dev-agent-key

# Sign in with Google (OAuth client of type "Web application"). Leave empty to hide the button.
# Authorized redirect URI: http://localhost:5050/auth/google/callback (match WEB_PORT)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloud database (Somee MS SQL). Leave empty to fall back to local SQLite.
# Password with special characters must be URL-encoded (@ -> %40, # -> %23).
# DATABASE_URL=mssql+pymssql://LOGIN:PASSWORD@YOURDB.mssql.somee.com:1433/YOURDB
DATABASE_URL=

# Tavily MCP (web search for the screening agent)
TAVILY_API_KEY=

# Deep Agent model: auto (Gemini, Ollama on this machine as fallback), gemini, or ollama
LLM_PROVIDER=auto
GEMINI_API_KEY=
# Tried in order; each model has its own free daily quota (gemini-2.5-flash: 20 requests/day)
GEMINI_MODEL=gemini-2.5-flash,gemini-3.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite
# host.docker.internal reaches Ollama installed on Windows from inside Docker
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_CTX=16384

WORKER_POLL_SECONDS=20
# Decision emails (Gmail MCP): no keys here. The OAuth files live in secrets/gmail/ (README, Gmail section).
EMAIL_RETRY_SECONDS=300
CHROMA_PATH=chroma_data
